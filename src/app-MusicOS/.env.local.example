# MusicOS — variáveis de ambiente
# Copie para .env.local e preencha. Nunca commite o .env.local.

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Chave service_role: SOMENTE no servidor (webhook do Stripe e checkout). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---------- Stripe (Developers → API keys) ----------
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → endpoint https://SEU-DOMINIO/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dos planos (Catálogo de produtos → crie 3 preços e cole os IDs)
#   Pro Mensal   : recorrente, mensal  (R$ 9,90)
#   Pro Anual    : recorrente, anual   (R$ 89,00)
#   Vitalício    : pagamento único     (R$ 197,00)
# Opcional: se criar os preços com as chaves de pesquisa musicos_pro_monthly,
# musicos_pro_yearly e musicos_lifetime, pode deixar estas linhas vazias.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_LIFETIME=

# Opcional: exigir aceite dos Termos no Checkout (antes, cadastre a URL dos termos
# em Stripe → Settings → Business → Public details). 1 = ligado.
STRIPE_TOS_CONSENT=0

# ---------- Rotinas ----------
# Segredo da reconciliação diária (GET /api/cron/reconcile). Gere um valor longo e aleatório.
CRON_SECRET=
# Premiação do ranking: 1 = aplica o desconto direto; 0 = espera aprovação no Supabase (recomendado)
REWARDS_AUTO_APPLY=0

# ---------- App ----------
# URL pública do site (usada nos retornos do Stripe e do login com Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000
